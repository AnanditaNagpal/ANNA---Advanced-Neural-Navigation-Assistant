import cv2
import mediapipe as mp
import pickle
import time

with open("model.pkl", "rb") as f:
    model = pickle.load(f)

mp_hands = mp.solutions.hands
hands = mp_hands.Hands()

cap = cv2.VideoCapture(0, cv2.CAP_AVFOUNDATION)

sentence = ""
last_letter = ""
last_time = 0

while True:
    ret, frame = cap.read()
    if not ret:
        break

    frame = cv2.flip(frame, 1)

    img_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    results = hands.process(img_rgb)

    current_letter = ""

    if results.multi_hand_landmarks:
        for handLms in results.multi_hand_landmarks:
            row = []
            for lm in handLms.landmark:
                row.append(lm.x)
                row.append(lm.y)

            pred = model.predict([row])[0]
            current_letter = pred

    # 👉 Add letter only if stable (avoid spam)
    current_time = time.time()
    if current_letter != "" and current_letter != last_letter:
        if current_time - last_time > 1:
            sentence += current_letter
            last_letter = current_letter
            last_time = current_time

    # 👉 Controls
    key = cv2.waitKey(1)

    if key == ord('c'):   # clear sentence
        sentence = ""

    if key == ord(' '):   # space
        sentence += " "

    # Display
    cv2.putText(frame, f"Letter: {current_letter}", (10,50),
                cv2.FONT_HERSHEY_SIMPLEX, 1, (0,255,0), 2)

    cv2.putText(frame, f"Text: {sentence}", (10,100),
                cv2.FONT_HERSHEY_SIMPLEX, 1, (255,0,0), 2)

    cv2.imshow("Sign to Text", frame)

    if key == 27:
        break

cap.release()
cv2.destroyAllWindows()
